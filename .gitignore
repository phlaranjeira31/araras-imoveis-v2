# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

# prisma local sqlite
prisma/*.db
prisma/*.db-journal

# uploads locais (não versionar)
public/uploads/
public/uploads/**

# bancos locais
prisma/dev.db
prisma/*.db
prisma/*.db-journal

# backups/temporários de migrations
prisma/migrations_sqlite_backup/
prisma/migrations_sqlite_backup/**
prisma/*backup*
