generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Imovel {
  id                   String   @id @default(cuid())
  title                String
  city                 String
  neighborhood         String
  cep                  String?
  street               String?
  number               String?
  lat                  Float?
  lng                  Float?
  price                Int?
  priceRent            Int?
  slug                 String   @unique
  coverPhotoId         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  purpose              String?  @default("comprar")
  tipo                 String?
  featured             Boolean  @default(false)
  featuredAt           DateTime?
  quartos              Int?
  suites               Int?
  banheiros            Int?
  vagas                Int?
  areaConstruida       Int?
  areaTerreno          Int?
  mobiliado            Boolean?
  condominio           Int?
  iptu                 Int?
  corretoraCaptacao    String?
  endereco             String?
  descricao            String?
  proprietarioNome     String?
  proprietarioTelefone String?
  proprietarioCpf      String?
  proprietarioEmail    String?
  condominioNome       String?
  codigo               String?  @unique
  observacoesInternas String?
  
  photos               Photo[]


  ativo     Boolean  @default(true)

  @@index([city])
  @@index([city, neighborhood])
  @@index([neighborhood])
  @@index([price])
  @@index([purpose])
  @@index([tipo])
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  imovelId  String
  createdAt DateTime @default(now())
  publicId  String?  @unique
  imovel    Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@index([imovelId])
}
